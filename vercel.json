{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/demo1",
      "destination": "/demo1/index.html"
    },
    {
      "source": "/demo1/:path*",
      "destination": "/demo1/index.html"
    },
    {
      "source": "/demo2",
      "destination": "/demo2/index.html"
    },
    {
      "source": "/demo2/:path*",
      "destination": "/demo2/index.html"
    }
  ]
}